<Application x:Class="MortysDLP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MortysDLP"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Markenfarben: wärmer und gedämpfter, "Neon auf Nacht". Gelb und Orange sind ein
                 Paar und gehören immer gegen dunklen Grund, nie auf Weiss; auf gefüllten
                 Akzentflächen steht dunkle Schrift. -->
            <Color x:Key="BrandYellow">#F5C07C</Color>
            <Color x:Key="BrandOrange">#F09346</Color>
            <Color x:Key="BrandCream">#F0F0F0</Color>
            <Color x:Key="BrandDark">#202020</Color>
            <Color x:Key="BrandGrey">#2D2D2D</Color>

            <SolidColorBrush x:Key="BrandYellowBrush"  Color="#F5C07C"/>
            <SolidColorBrush x:Key="BrandOrangeBrush"  Color="#F09346"/>
            <SolidColorBrush x:Key="BrandCreamBrush"   Color="#F0F0F0"/>
            <SolidColorBrush x:Key="BrandDarkBrush"    Color="#202020"/>
            <SolidColorBrush x:Key="BrandGreyBrush"    Color="#2D2D2D"/>

            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F5C07C" Offset="0"/>
                <GradientStop Color="#F09346" Offset="1"/>
            </LinearGradientBrush>

            <!-- Mitgelieferte Schrift (SIL OFL 1.1): Inter und die enger gezeichnete Schwester
                 Inter Tight, beide eingebettet. Welche verwendet wird, steuert die Einstellung
                 "Schriftbild" (Kompakt = Inter Tight, Standard/Luftig = Inter) über
                 Helpers/FontAppearance.cs zur Laufzeit - deshalb hängen alle Verweise an
                 DynamicResource, nicht StaticResource. Die Werte hier sind nur der Startwert,
                 bis FontAppearance.ApplyFromSettings() im OnStartup läuft. Segoe UI als
                 Rückfall, falls die eingebettete Datei nicht lädt. Debug-/Protokollausgabe
                 bleibt bewusst bei Consolas. -->
            <FontFamily x:Key="AppFontFamily">pack://application:,,,/Resources/Fonts/#Inter, Segoe UI Variable, Segoe UI</FontFamily>

            <!-- Mindest-Zeilenhöhe für Fließtext. NaN = natürliche Höhe der Schrift
                 (Kompakt/Standard); "Luftig" setzt einen festen Wert. LineStackingStrategy
                 bleibt auf dem Standard "MaxHeight", der Wert klippt also nie, er kann nur
                 mehr Luft geben. -->
            <sys:Double x:Key="AppLineHeight">NaN</sys:Double>

            <!-- Akzentfarben des Fluent-Themes auf die Marke legen. Vier Schlüssel allein
                 reichen nicht - zusätzlich braucht es die eigenen
                 Ressourcen von AccentButtonStyle und der Standard-ProgressBar: Beide hängen
                 NICHT an AccentFillColor*Brush, sondern an eigenen Schlüsseln (geprüft gegen
                 PresentationFramework.Fluent 10.0.11) - ohne die bleiben Knopf und Balken beim
                 Windows-Systemblau statt bei der Marke. Sekundär/Tertiär sind eine hellere und
                 eine dunklere Ableitung der Marken-Orange (#F09346). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"       Color="#F09346"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"     Color="#F4A365"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"      Color="#D97E38"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#202020"/>

            <SolidColorBrush x:Key="AccentButtonBackground"            Color="#F09346"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#F4A365"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"     Color="#D97E38"/>
            <SolidColorBrush x:Key="AccentButtonForeground"            Color="#202020"/>

            <SolidColorBrush x:Key="ProgressBarForeground"             Color="#F09346"/>

            <!-- Statusfarben (Erfolg/Warnung/Fehler/Läuft). Success/Warning/Error/Running
                 brauchen je einen hellen UND einen dunklen Wert, den WPF anders als bei den
                 obigen Fluent-Ressourcen nicht selbst nachführt (kein ThemeDictionaries-Tag in
                 klassischem WPF) - Services/StatusColorSync.cs setzt die vier Farben beim Start
                 und bei jedem Windows-Themawechsel per Code. Die Startwerte hier sind hell,
                 rein damit die Ressource nie unbelegt ist, bevor der erste Sync-Aufruf läuft.
                 NeutralBrush braucht das nicht: Es zeigt direkt auf eine Fluent-Ressource, die
                 sich bereits selbst um Hell/Dunkel kümmert. -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
            <SolidColorBrush x:Key="ErrorBrush"   Color="#C42B1C"/>
            <SolidColorBrush x:Key="RunningBrush" Color="#F09346"/>
            <SolidColorBrush x:Key="NeutralBrush" Color="{DynamicResource TextFillColorSecondary}"/>

            <!-- Global TextBlock style for adaptive Light/Dark text -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="LineHeight" Value="{DynamicResource AppLineHeight}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global Label style for adaptive Light/Dark text -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Primary action button: Akzentfarbe kommt aus AccentButtonStyle (oben belegt),
                 hier nur noch, was die Akzentfarbe nicht schon leistet. Padding auf einem
                 4-Pixel-Raster. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding"    Value="16,4"/>
            </Style>

            <!-- Karte: eine Zeile XAML statt fünf wiederholter Attribute.
                 Innenabstand 16,12 und Kartenabstand 12 auf einem 4-Pixel-Raster. Bewusst OHNE
                 BasedOn: Anders als Button/TextBlock hat Border im Fluent-Theme keinen
                 impliziten Stil - {StaticResource {x:Type Border}} existiert nicht und wirft
                 beim Start eine XamlParseException (live geprüft, .NET 10.0.11). -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background"      Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16,12"/>
                <Setter Property="Margin"          Value="0,0,0,12"/>
            </Style>

            <!-- Abschnittsüberschrift innerhalb einer Karte. Die Schriftgröße wird spaeter auf
                 die Typo-Skala umgestellt, hier zunaechst nur der Abstand auf dem Raster. -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="FontSize"    Value="11"/>
                <Setter Property="Foreground"  Value="{StaticResource BrandOrangeBrush}"/>
                <Setter Property="Margin"      Value="0,0,0,8"/>
            </Style>

            <!-- Aktionsleiste (Status/Fortschritt/Knöpfe) - fixierte Fußzeile unterhalb des
                 ScrollViewer, bleibt beim Scrollen sichtbar. Margin nur oben: trennt sie
                 sichtbar vom Scrollbereich, aber sie ist selbst das letzte Element im
                 Seiten-Grid. Innenabstand wie die Karte (16,12). -->
            <Style x:Key="ActionBarStyle" TargetType="Border">
                <Setter Property="Background"      Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16,12"/>
                <Setter Property="Margin"          Value="0,12,0,0"/>
            </Style>

            <!-- Beschriftungsspalte: eine gemeinsame Breite statt einer eigenen
                 MinWidth je Seite. Grid.IsSharedSizeScope trägt NICHT über Frame-Navigation
                 hinweg (live geprüft: ein per Navigate() entladenes Page-Grid meldet seine
                 Spaltenbreite beim SharedSizeScope ab, die nächste Seite sieht davon nichts
                 mehr) - deshalb eine feste Konstante statt der dynamischen Gruppe.
                 230 DIP deckt die längste vorkommende Beschriftung in beiden Sprachen
                 („Twitch-URL, VOD-ID oder Clip-Slug:", ~224 DIP gemessen) mit etwas Luft.
                 BasedOn nötig, sonst geht die helle/dunkle Vordergrundfarbe des Label-Stils
                 oben verloren (anders als bei Border hat Label im Projekt bereits einen
                 impliziten Stil, das BasedOn funktioniert hier nachweislich). -->
            <Style x:Key="FormLabelStyle" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="MinWidth" Value="230"/>
            </Style>

            <!-- Zweite, schmalere Gruppe für Beschriftungen, die zu zweit auf einer Zeile
                 stehen (z. B. „Start (hh:mm:ss):" / „Ende (hh:mm:ss):"). Mit der breiten
                 FormLabelStyle-Spalte würde eine solche Zeile unnötig in die Breite gezogen.
                 112 DIP deckt die längste dieser kurzen Beschriftungen (~108 DIP gemessen). -->
            <Style x:Key="FormLabelShortStyle" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="MinWidth" Value="112"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
