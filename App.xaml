<Application x:Class="MortysDLP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MortysDLP"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand Colors -->
            <Color x:Key="BrandYellow">#ffe44e</Color>
            <Color x:Key="BrandOrange">#e67e50</Color>
            <Color x:Key="BrandCream">#fff8e7</Color>
            <Color x:Key="BrandDark">#1E212B</Color>

            <SolidColorBrush x:Key="BrandYellowBrush"  Color="#ffe44e"/>
            <SolidColorBrush x:Key="BrandOrangeBrush"  Color="#e67e50"/>
            <SolidColorBrush x:Key="BrandCreamBrush"   Color="#fff8e7"/>
            <SolidColorBrush x:Key="BrandDarkBrush"    Color="#1E212B"/>

            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#ffe44e" Offset="0"/>
                <GradientStop Color="#e67e50" Offset="1"/>
            </LinearGradientBrush>

            <!-- Akzentfarben des Fluent-Themes auf die Marke legen. Vier Schlüssel allein
                 reichen nicht - zusätzlich braucht es die eigenen
                 Ressourcen von AccentButtonStyle und der Standard-ProgressBar: Beide hängen
                 NICHT an AccentFillColor*Brush, sondern an eigenen Schlüsseln (geprüft gegen
                 PresentationFramework.Fluent 10.0.11) - ohne die bleiben Knopf und Balken beim
                 Windows-Systemblau statt bei der Marke. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"       Color="#e67e50"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"     Color="#f08f62"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"      Color="#d4724a"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1E212B"/>

            <SolidColorBrush x:Key="AccentButtonBackground"            Color="#e67e50"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#f08f62"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"     Color="#d4724a"/>
            <SolidColorBrush x:Key="AccentButtonForeground"            Color="#1E212B"/>

            <SolidColorBrush x:Key="ProgressBarForeground"             Color="#e67e50"/>

            <!-- Statusfarben (Erfolg/Warnung/Fehler/Läuft). Success/Warning/Error/Running
                 brauchen je einen hellen UND einen dunklen Wert, den WPF anders als bei den
                 obigen Fluent-Ressourcen nicht selbst nachführt (kein ThemeDictionaries-Tag in
                 klassischem WPF) - Services/StatusColorSync.cs setzt die vier Farben beim Start
                 und bei jedem Windows-Themawechsel per Code. Die Startwerte hier sind hell,
                 rein damit die Ressource nie unbelegt ist, bevor der erste Sync-Aufruf läuft.
                 NeutralBrush braucht das nicht: Es zeigt direkt auf eine Fluent-Ressource, die
                 sich bereits selbst um Hell/Dunkel kümmert. -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
            <SolidColorBrush x:Key="ErrorBrush"   Color="#C42B1C"/>
            <SolidColorBrush x:Key="RunningBrush" Color="#e67e50"/>
            <SolidColorBrush x:Key="NeutralBrush" Color="{DynamicResource TextFillColorSecondary}"/>

            <!-- Global TextBlock style for adaptive Light/Dark text -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global Label style for adaptive Light/Dark text -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Primary action button: Akzentfarbe kommt aus AccentButtonStyle (oben belegt),
                 hier nur noch, was die Akzentfarbe nicht schon leistet. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding"    Value="14,5"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
