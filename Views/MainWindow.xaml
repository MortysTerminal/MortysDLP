<Window x:Class="MortysDLP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Icons/mw_globe_32px.ico"
        Title="MortysDLP"
        WindowStartupLocation="CenterScreen"
        Width="1430" Height="950"
        MinWidth="1100" MinHeight="700"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left accent bar (Windows 11 style) -->
                            <Border x:Name="AccentBar" Grid.Column="0"
                                    Background="Transparent"
                                    CornerRadius="0,2,2,0"/>

                            <!-- Content area -->
                            <Border x:Name="ContentBorder" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentBorder" Property="Background" 
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" 
                                        Value="{StaticResource BrandOrangeBrush}"/>
                                <Setter TargetName="ContentBorder" Property="Background" 
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ContentBorder" Property="Background" 
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + App-Titel -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="38" Height="38" CornerRadius="19"
                            BorderBrush="{StaticResource BrandYellowBrush}" BorderThickness="1.5"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Image Source="/Resources/Logos/globus.png" Width="24" Height="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAppTitle" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="txtAppSubtitle" Opacity="0.6" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox x:Name="NavigationList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavigationList_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItemStyle}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavDownload" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavBatchDownload" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B1;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavConvert" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavTranscribe" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE786;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavGifMaker" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE93E;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavTwitchDownload" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Werkzeuge und Einstellungen – abgesetzt unten links, über dem Spenden-Button -->
                <ListBox x:Name="SettingsNavigationList" Grid.Row="3"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="SettingsNavigationList_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Margin="0,0,0,8">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <StackPanel>
                                <Separator Margin="0,0,0,8"
                                           Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                <ItemsPresenter/>
                            </StackPanel>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavTools" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                            <TextBlock x:Name="txtNavSettings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Credits-Button -->
                <Button x:Name="btnCredits" Grid.Row="4"
                        Click="btnCredits_Click"
                        Margin="0,0,0,6"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand"
                        ToolTip="Open Source &amp; Credits">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorderC"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorderC" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                <Setter TargetName="btnBorderC" Property="BorderBrush"
                                                        Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorderC" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtCreditsTitle" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="txtCreditsSubtitle" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- joke: Support-Button unten links -->
                <Button x:Name="btnJokeDonate" Grid.Row="5"
                        Click="btnJokeDonate_Click"
                        Margin="0,0,0,0"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand"
                        ToolTip="Support this project ❤️">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush"
                                                        Value="{StaticResource BrandYellowBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#e05c7a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtJokeDonateTitle" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="txtJokeDonateSubtitle" FontSize="10" Opacity="0.6"
                                       TextDecorations="Underline"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- INHALTSBEREICH -->
        <Grid Grid.Column="1" Margin="14,14,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Update-Banner (nur sichtbar wenn Update verfügbar). Bewusst die volle
                 Markenfläche: der Hinweis soll auffallen, nicht sich einfügen. Dunkler,
                 fetter Text auf Markengelb (hoher Kontrast). -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Margin="0,0,0,8"
                    ClipToBounds="True"
                    Background="{StaticResource BrandYellowBrush}"
                    BorderBrush="{StaticResource BrandOrangeBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Klickbarer Bereich mit Icon + Text -->
                    <Button Grid.Column="0"
                            x:Name="btnUpdateBanner"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            Click="btnUpdateBanner_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#28000000"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#3D000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;"
                                       FontSize="17"
                                       Foreground="{StaticResource BrandDarkBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtUpdateBannerMain"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource BrandDarkBrush}"/>
                                <TextBlock x:Name="txtUpdateBannerSub"
                                           FontSize="11" Opacity="0.8"
                                           Foreground="{StaticResource BrandDarkBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Schließen-Button -->
                    <Button Grid.Column="1"
                            x:Name="btnDismissBanner"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="36"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            ToolTip="{Binding}"
                            Click="btnDismissBanner_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#28000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                   FontSize="12"
                                   Foreground="{StaticResource BrandDarkBrush}"
                                   Opacity="0.8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Header-Leiste - Folien-Stil: (Kicker) / Titel / kurze Zeile / kurzer
                 Verlaufs-Strich; Info-Knopf und Version rechts oben. -->
            <Border Grid.Row="1" CornerRadius="10" Margin="0,0,0,12"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid Margin="16,12,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Kicker: vorbereiteter Platz, leer und ausgeblendet bis der
                             Schluessel "Header.Kicker" gefuellt wird. -->
                        <TextBlock x:Name="txtHeaderKicker" Visibility="Collapsed"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandOrangeBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtSectionTitle" FontWeight="Bold" FontSize="20"/>
                        <TextBlock x:Name="txtHeaderSubtitle" FontSize="12" Opacity="0.65"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <Rectangle Height="2" Width="44" HorizontalAlignment="Left"
                                   RadiusX="1" RadiusY="1" Margin="0,8,0,0"
                                   Fill="{StaticResource BrandGradientBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnHeaderInfo" Click="btnHeaderInfo_Click"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                            <TextBlock x:Name="txtHeaderInfoIcon" Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" Opacity="0.45" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="txtVersionLabel" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblMainVersion" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Text="-"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Erklaerung zur aktuellen Seite: dezent hinter dem Info-Knopf, unter dem Titel. -->
            <Popup x:Name="HeaderInfoPopup"
                   PlacementTarget="{Binding ElementName=txtSectionTitle}"
                   Placement="Bottom" VerticalOffset="10"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <!-- Der Popup liegt ausserhalb des Fensters (AllowsTransparency); der
                     durchscheinende Card-Pinsel waere hier unlesbar - deshalb der volldeckende
                     Solid-Hintergrund. -->
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        MaxWidth="440" Margin="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock x:Name="txtHeaderInfoBody" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Border>
            </Popup>

            <!-- Seiten-Frame -->
            <Frame x:Name="MainFrame" Grid.Row="2"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
