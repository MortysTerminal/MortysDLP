<Page x:Class="MortysDLP.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:MortysDLP.Helpers"
      Title="Werkzeuge"
      Loaded="ToolsPage_Loaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- ALLE PRÜFEN -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtCheckAllHint" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                    <Button x:Name="btnCheckAll" Grid.Column="1" Click="btnCheckAll_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- WERKZEUGE -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="txtSectionTools" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtTotalSize" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl x:Name="icTools">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="12,12" Margin="0,0,0,8"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <Border Visibility="{Binding RequiredForOperation, Converter={StaticResource BoolToVis}}"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="4" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RequiredBadgeText}" FontSize="10"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UsedForText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                       Style="{StaticResource StatusToneTextStyle}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <TextBlock Grid.Column="2" Text="{Binding VersionText}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="3" Text="{Binding LocationText}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis" FontSize="12"
                                                       ToolTip="{Binding LocationText}"/>

                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right" Margin="0,0,8,0"/>

                                            <!-- Jede Zeile hat dieselben Knopftexte - für Screenreader trägt jeder Knopf
                                                 zusätzlich den Werkzeugnamen ("whisper.cpp: Deinstallieren"). -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                <Button Content="{Binding RepairButtonText}" Tag="{Binding ToolId}"
                                                        IsEnabled="{Binding CanRepair}" Click="btnRepair_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                                                    <AutomationProperties.Name>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="DisplayName"/>
                                                            <Binding Path="RepairButtonText"/>
                                                        </MultiBinding>
                                                    </AutomationProperties.Name>
                                                </Button>
                                                <Button Content="{Binding UpdateButtonText}" Tag="{Binding ToolId}"
                                                        Visibility="{Binding UpdateVisibility}" Click="btnUpdate_Click"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Margin="0,0,8,0">
                                                    <AutomationProperties.Name>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="DisplayName"/>
                                                            <Binding Path="UpdateButtonText"/>
                                                        </MultiBinding>
                                                    </AutomationProperties.Name>
                                                </Button>
                                                <Button Content="{Binding UninstallButtonText}" Tag="{Binding ToolId}"
                                                        IsEnabled="{Binding CanUninstall}" Click="btnUninstall_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                                                    <AutomationProperties.Name>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="DisplayName"/>
                                                            <Binding Path="UninstallButtonText"/>
                                                        </MultiBinding>
                                                    </AutomationProperties.Name>
                                                </Button>
                                                <Button Content="{Binding OpenFolderButtonText}" Tag="{Binding ToolId}"
                                                        IsEnabled="{Binding CanOpenFolder}" Click="btnOpenFolder_Click"
                                                        Style="{StaticResource SecondaryButtonStyle}">
                                                    <AutomationProperties.Name>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="DisplayName"/>
                                                            <Binding Path="OpenFolderButtonText"/>
                                                        </MultiBinding>
                                                    </AutomationProperties.Name>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Fortschritt während einer laufenden Aktion -->
                                        <Grid Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"
                                              Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"
                                                           helpers:A11y.AnnounceChanges="True"/>
                                                <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1"
                                                             Height="{StaticResource ProgressBarHeight}"
                                                             AutomationProperties.Name="{Binding DisplayName}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="btnCancelRow_Click" VerticalAlignment="Center"
                                                    Content="{Binding CancelButtonText}"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                <AutomationProperties.Name>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="DisplayName"/>
                                                        <Binding Path="CancelButtonText"/>
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- WHISPER-MODELLE -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="txtSectionModels" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnManageModels" Click="btnManageModels_Click"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <TextBlock x:Name="txtModelsSummary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <ItemsControl x:Name="icModels">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,8"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="0,0,8,0" FontSize="12"/>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StatusToneTextStyle}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
