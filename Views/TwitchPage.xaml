<Page x:Class="MortysDLP.Views.TwitchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="clr-namespace:MortysDLP.Views"
      Title="Twitch VOD-Download"
      Loaded="TwitchPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- TWITCHDOWNLOADERCLI STATUS -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionTool" Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="txtToolStatus" TextWrapping="Wrap" Margin="0,0,0,4" Opacity="0.85"/>
                    <TextBlock x:Name="txtFileSize" TextWrapping="Wrap" Margin="0,0,0,8"
                               Opacity="0.55" FontSize="11" Visibility="Collapsed"/>

                    <!-- Update-Hinweis (dezent, nur sichtbar wenn Update verfügbar) -->
                    <Border x:Name="pnlUpdateHint" CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrandOrangeBrush}"/>
                            <TextBlock x:Name="txtUpdateHint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <!-- Nur sichtbar solange nicht installiert -->
                        <Button x:Name="btnInstall" Click="btnInstall_Click" MinWidth="120"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <!-- Sichtbar wenn installiert: adaptiver Update/Check-Button -->
                        <Button x:Name="btnUpdateAction" Click="btnUpdateAction_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="180"
                                Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False"/>
                        <Button x:Name="btnUninstall" Click="btnUninstall_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sperr-Karte: sichtbar, wenn yt-dlp oder ffmpeg für den VOD-Download fehlt. -->
            <v:ToolMissingNotice x:Name="toolNotice"/>

            <!-- VOD-DOWNLOAD -->
            <Border x:Name="borderDownload" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionDownload" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- URL / ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label x:Name="lblURL" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="tbURL" Width="480" VerticalContentAlignment="Center" Margin="8,0,0,0"
                                 TextChanged="tbURL_TextChanged"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipURL"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Ausgabeordner -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" x:Name="lblOutputPath" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="tbOutputPath" MinWidth="120" IsReadOnly="True" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="8,0,8,0"
                                 ToolTip="{Binding ElementName=tbOutputPath, Path=Text}"/>
                        <Button Grid.Column="2" x:Name="btnUseGlobalPath" Click="btnUseGlobalPath_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" MinWidth="100"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="3" x:Name="btnBrowseOutput" Click="btnBrowseOutput_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" MinWidth="100"/>
                        <Button Grid.Column="4" x:Name="btnOpenOutput" Click="btnOpenOutput_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" MinWidth="100"
                                Margin="8,0,0,0" IsEnabled="False"/>
                    </Grid>

                    <!-- Video-Download-Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="cbDownloadVideo" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="cbDownloadVideo_Changed" Unchecked="cbDownloadVideo_Changed"/>
                        <TextBlock x:Name="txtDownloadVideo" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipDownloadVideo"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Chat-Download-Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="cbDownloadChat" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="cbDownloadChat_Changed" Unchecked="cbDownloadChat_Changed"/>
                        <TextBlock x:Name="txtDownloadChat" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipDownloadChat"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Chat-Format-Auswahl (nur sichtbar wenn Chat-Download aktiv) -->
                    <StackPanel x:Name="pnlChatOptions" Orientation="Vertical"
                                Margin="24,0,0,0" Visibility="Collapsed">
                        <!-- Option 1: Nur JSON -->
                        <RadioButton x:Name="rbChatJson" GroupName="ChatMode"
                                     IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtChatJson" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Text="&#xE946;" Opacity="0.7" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip x:Name="tooltipChatJson"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </RadioButton>

                        <!-- Option 2: Als Video rendern -->
                        <RadioButton x:Name="rbChatRender" GroupName="ChatMode"
                                     VerticalAlignment="Center" Margin="0,0,0,8"
                                     Checked="rbChatRender_Changed" Unchecked="rbChatRender_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtChatRender" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Text="&#xE946;" Opacity="0.7" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip x:Name="tooltipChatRender"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </RadioButton>

                        <!-- Render-Qualität (nur sichtbar wenn "Als Video rendern") -->
                        <StackPanel x:Name="pnlRenderQuality" Orientation="Horizontal"
                                    Margin="0,0,0,8" Visibility="Collapsed">
                            <Label x:Name="lblRenderQuality" VerticalAlignment="Center" Padding="0,0,8,0" Style="{StaticResource FormLabelShortStyle}"/>
                            <ComboBox x:Name="cbRenderQuality" Width="160" VerticalContentAlignment="Center">
                                <ComboBoxItem x:Name="cbiQualityStandard" IsSelected="True"/>
                                <ComboBoxItem x:Name="cbiQualityHigh"/>
                                <ComboBoxItem x:Name="cbiQualityUltra"/>
                            </ComboBox>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Text="&#xE946;" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.ToolTip>
                                    <ToolTip x:Name="tooltipRenderQuality"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <!-- GPU-Warnhinweis (nur bei "Als Video rendern") -->
                        <Border x:Name="pnlGpuHint" CornerRadius="4" Padding="12,8" Margin="0,0,0,4"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource BrandOrangeBrush}"/>
                                <TextBlock x:Name="txtGpuHint" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Opacity="0.9" MaxWidth="480"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- BANDWIDTH-HINWEIS -->
            <Border x:Name="borderBandwidthHint" Style="{StaticResource CardBorderStyle}"
                    Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtBandwidthHint" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
            </Border>

            <!-- DEBUG -->
            <DockPanel x:Name="dockDebug" Margin="0,4,0,0" Visibility="Collapsed">
                <Expander x:Name="expDebug" IsExpanded="False">
                    <TextBox x:Name="tbDebugOutput" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True"
                             MaxHeight="200"/>
                </Expander>
            </DockPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- AKTIONEN + FORTSCHRITT - fixierte Fußzeile, scrollt nicht mit. Wird zusammen mit
             dem VOD-Download-Abschnitt ausgeblendet, solange TwitchDownloaderCLI fehlt. -->
        <Border x:Name="borderActions" Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnStart" Click="btnStart_Click" MinWidth="100"
                            Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="btnCancel" Click="btnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" MinWidth="100"
                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Border Padding="12,0,0,0">
                        <StackPanel x:Name="spLoadingbar" Visibility="Hidden" Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="4,0,4,2">
                                <TextBlock x:Name="txtDownloadStatus" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtDownloadSpeed" Margin="8,0,0,0" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            <ProgressBar x:Name="pbDownload"
                                         Width="200" Height="11"
                                         IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Border>
    </Grid>
</Page>
