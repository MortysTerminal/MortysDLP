<Window x:Class="MortysDLP.Views.WhisperModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:MortysDLP.Helpers"
        Title="Whisper-Modelle verwalten"
        Width="760" Height="600"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="txtHeaderTitle" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="txtHeaderSubtitle" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Whisper Engine Status -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtWhisperEngineStatus" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModelsDir" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnUninstall" Click="btnUninstall_Click" Margin="0,0,8,0" MinWidth="100"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>
                    <Button x:Name="btnInstallWhisper" Click="btnInstallWhisper_Click" MinWidth="100"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Download-Fortschritt -->
        <Border Grid.Row="2" x:Name="pnlProgress" Visibility="Collapsed"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="txtProgressLabel" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               helpers:A11y.AnnounceChanges="True"/>
                    <Button Grid.Column="1" x:Name="btnCancelProgress" Click="btnCancelProgress_Click"
                            Margin="8,0,0,0" MinWidth="100"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
                <ProgressBar x:Name="pbProgress"
                             Height="{StaticResource ProgressBarHeight}" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/>
                <TextBlock x:Name="txtProgressPercent" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Modell-Liste -->
        <ScrollViewer x:Name="scrollModels" Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl x:Name="icModels">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + Beschreibung -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,0"/>
                                </StackPanel>

                                <!-- Größe -->
                                <TextBlock Grid.Column="1" Text="{Binding SizeHint}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                <!-- Status -->
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Style="{StaticResource StatusToneTextStyle}"/>

                                <!-- Aktions-Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding DownloadButtonText}"
                                            IsEnabled="{Binding CanDownload}"
                                            Visibility="{Binding DownloadVisibility}"
                                            Tag="{Binding ModelId}"
                                            Click="btnDownloadModel_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,4,0"/>
                                    <Button Content="{Binding DeleteButtonText}"
                                            IsEnabled="{Binding CanDelete}"
                                            Visibility="{Binding DeleteVisibility}"
                                            Tag="{Binding ModelId}"
                                            Click="btnDeleteModel_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Trennlinie -->
        <Separator Grid.Row="4" Margin="0,0,0,8"/>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnClose" Click="btnClose_Click" IsCancel="True" MinWidth="100"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
