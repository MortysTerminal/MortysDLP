<Page x:Class="MortysDLP.Views.TranscribePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="clr-namespace:MortysDLP.Views"
      Title="Transkribieren"
      Loaded="TranscribePage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- WHISPER STATUS -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionWhisper" Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,8"/>

                    <!-- Setup-Schritte (sichtbar wenn nicht vollständig eingerichtet) -->
                    <Border x:Name="pnlSetup" CornerRadius="4" Padding="12,12" Margin="0,0,0,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="txtSetupHint" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="txtSetupStep1" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="260"/>
                                <TextBlock x:Name="txtSetupStep1Status" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtSetupStep2" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="260"/>
                                <TextBlock x:Name="txtSetupStep2Status" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fertig-Status (sichtbar wenn alles eingerichtet) -->
                    <TextBlock x:Name="txtWhisperStatus" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnManageModels" Click="btnManageModels_Click" MinWidth="100"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="btnInstallWhisper" Click="btnInstallWhisper_Click" MinWidth="100" Padding="12,4"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sperr-Karte: sichtbar, wenn ffmpeg für die Audio-Extraktion fehlt. -->
            <v:ToolMissingNotice x:Name="toolNotice"/>

            <!-- EINGABEDATEI -->
            <Border x:Name="borderInput" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionInput" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" x:Name="lblInputFile" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="tbInputFile" MinWidth="150" IsReadOnly="True"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,8,0"
                                 ToolTip="{Binding ElementName=tbInputFile, Path=Text}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" x:Name="btnBrowseInput" Click="btnBrowseInput_Click" VerticalAlignment="Center" MinWidth="100" Padding="12,4">
                            <TextBlock x:Name="txtBrowseInput"/>
                        </Button>
                        <TextBlock Grid.Column="3" x:Name="imgInputInfo" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipInputFile"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- EINSTELLUNGEN -->
            <Border x:Name="borderSettings" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionSettings" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Modell -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label x:Name="lblModel" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="combModel" Width="280" Margin="8,0,0,0" VerticalContentAlignment="Center">
                            <TextBlock x:Name="imgModelInfo" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.ToolTip>
                                    <ToolTip x:Name="tooltipModel"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </ComboBox>
                        <TextBlock x:Name="imgModelInfoIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipModel2"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Sprache -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label x:Name="lblLanguage" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="combLanguage" Width="200" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="imgLangInfo" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipLang"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Ausgabeformat -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Label x:Name="lblOutputFormat" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Margin="8,0,0,0">
                            <CheckBox x:Name="cbOutputTxt" IsChecked="True" Margin="0,0,0,4">
                                <TextBlock x:Name="txtOutputTxt"/>
                            </CheckBox>
                            <CheckBox x:Name="cbOutputSrt" IsChecked="True" Margin="0,0,0,4">
                                <TextBlock x:Name="txtOutputSrt"/>
                            </CheckBox>
                            <CheckBox x:Name="cbOutputVtt" Margin="0,0,0,0">
                                <TextBlock x:Name="txtOutputVtt"/>
                            </CheckBox>
                        </StackPanel>
                        <TextBlock x:Name="imgFormatInfo" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Top" Margin="8,4,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipFormat"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AUSGABE -->
            <Border x:Name="borderOutput" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionOutput" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" x:Name="lblOutputDir" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" x:Name="tbOutputDir" MinWidth="150" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="8,0,8,0"/>
                        <Button Grid.Column="2" x:Name="btnBrowseOutput" Click="btnBrowseOutput_Click" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="txtBrowseOutput"/>
                        </Button>
                        <Button Grid.Column="3" x:Name="btnOpenOutput" Click="btnOpenOutput_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED25;" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="txtOpenOutput" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AUSGABE-LOG -->
            <DockPanel x:Name="dockLog" Margin="0,4,0,0">
                <Expander x:Name="expLog" IsExpanded="False">
                    <TextBox x:Name="tbLog" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" MaxHeight="200"
                             TextChanged="tbLog_TextChanged"/>
                </Expander>
            </DockPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- AKTIONEN + FORTSCHRITT - fixierte Fußzeile, scrollt nicht mit -->
        <Border x:Name="borderActions" Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnStart" Click="btnStart_Click"
                            Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center">
                        <Button.ToolTip>
                            <ToolTip x:Name="tooltipBtnStart"/>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnCancel" Click="btnCancel_Click" IsEnabled="False"
                            VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <!-- Fortschritt (läuft) -->
                    <Border x:Name="pnlRunning" Padding="12,0,0,0" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock x:Name="txtStatus" FontWeight="Bold"/>
                                <TextBlock x:Name="txtProgressPercent" Margin="8,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                            <ProgressBar x:Name="pbProgress"
                                         Width="250" Height="8"
                                         Minimum="0" Maximum="100" Value="0"
                                         IsIndeterminate="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Ergebnis (fertig / Fehler / abgebrochen) -->
                    <Border x:Name="pnlResult" Padding="12,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtResultTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtResultFile" Opacity="0.65" FontSize="11"
                                           MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="btnOpenResult" Click="btnOpenResult_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Background="Transparent" BorderThickness="0" Margin="12,0,0,0" Padding="0" Visibility="Collapsed">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="20"
                                               Foreground="{StaticResource BrandYellowBrush}" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Border>
    </Grid>
</Page>
