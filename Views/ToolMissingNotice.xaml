<UserControl x:Class="MortysDLP.Views.ToolMissingNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <TextBlock x:Name="txtTitle" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock x:Name="txtBody" TextWrapping="Wrap" LineHeight="20"
                       Opacity="0.85" Margin="0,0,0,12"/>
            <Button x:Name="btnToTools" Click="btnToTools_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
