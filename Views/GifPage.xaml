<Page x:Class="MortysDLP.Views.GifPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="clr-namespace:MortysDLP.Views"
      Title="GIF-Maker"
      Loaded="GifPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- Sperr-Karte: sichtbar, wenn ffmpeg/ffprobe fehlt. -->
            <v:ToolMissingNotice x:Name="toolNotice"/>
            <StackPanel x:Name="pnlWork">

            <!-- EINGABEDATEI -->
            <Border Style="{StaticResource CardBorderStyle}"
                    AllowDrop="True" Drop="borderInput_Drop" DragOver="borderInput_DragOver">
                <StackPanel>
                    <TextBlock x:Name="txtSectionInput" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lblInputFile" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="tbInputFile" Width="430" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="8,0,8,0"
                                 ToolTip="{Binding ElementName=tbInputFile, Path=Text}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                        </Trigger>
                                                      </Style.Triggers>
                                                     </Style>
                                                 </TextBox.Style>
                                             </TextBox>
                                             <Button x:Name="btnBrowseInput" Click="btnBrowseInput_Click" MinWidth="100" Padding="12,4">
                                                 <TextBlock x:Name="txtBrowseInput"/>
                                             </Button>
                                             <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipInputFile"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- EINSTELLUNGEN -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionSettings" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Qualität -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label x:Name="lblQuality" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox x:Name="combQuality" Width="240" Margin="8,0,0,0" VerticalContentAlignment="Center">
                            <ComboBoxItem x:Name="cbiQualityWeb" IsSelected="True"/>
                            <ComboBoxItem x:Name="cbiQualityLow"/>
                            <ComboBoxItem x:Name="cbiQualityMedium"/>
                            <ComboBoxItem x:Name="cbiQualityHigh"/>
                        </ComboBox>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipQuality"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Zeitbereich -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <CheckBox x:Name="cbTimeRange" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="cbTimeRange_Check" Unchecked="cbTimeRange_Check"/>
                        <Label x:Name="lblStartTime" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelShortStyle}"/>
                        <TextBox x:Name="tbStartTime" Width="100" IsEnabled="False" VerticalContentAlignment="Center" Margin="8,0,24,0"/>
                        <Label x:Name="lblEndTime" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelShortStyle}"/>
                        <TextBox x:Name="tbEndTime" Width="100" IsEnabled="False" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Text="&#xE946;" Opacity="0.8" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.ToolTip>
                                <ToolTip x:Name="tooltipTime"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AUSGABE -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSectionOutput" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Ausgabeordner -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="lblOutputFolder" VerticalAlignment="Center" Padding="0"
                               Style="{StaticResource FormLabelStyle}" Grid.Column="0"/>
                        <TextBox x:Name="tbOutputFolder" VerticalContentAlignment="Center"
                                 Margin="8,0,0,0" Grid.Column="1"/>
                        <Button x:Name="btnBrowseOutput" Click="btnBrowseOutput_Click"
                                MinWidth="100" Padding="12,4" Margin="8,0,0,0" Grid.Column="2">
                            <TextBlock x:Name="txtBrowseOutput"/>
                        </Button>
                        <Button x:Name="btnOpenOutput" Click="btnOpenOutput_Click"
                                MinWidth="100" Padding="12,4" Margin="8,0,0,0" Grid.Column="3">
                            <TextBlock x:Name="txtOpenOutput"/>
                        </Button>
                    </Grid>

                    <!-- Pfad übernehmen -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="txtUsePath" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnUseDownloadPath" Click="btnUseDownloadPath_Click" Width="140">
                                    <TextBlock x:Name="txtUseDownloadPath"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- DEBUG -->
            <DockPanel x:Name="borderDebug" Margin="0,4,0,0" Visibility="Collapsed">
                <Expander x:Name="expDebug" IsExpanded="False">
                    <TextBox x:Name="tbDebugOutput"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             MaxHeight="200"/>
                </Expander>
            </DockPanel>

            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- STEUERUNG + STATUS - fixierte Fußzeile, scrollt nicht mit -->
        <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnStart" Click="btnStart_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0">
                        <TextBlock x:Name="txtBtnStart"/>
                    </Button>
                    <Button x:Name="btnCancel" Click="btnCancel_Click" IsEnabled="False">
                        <TextBlock x:Name="txtBtnCancel"/>
                    </Button>

                    <!-- Fortschritt (läuft) -->
                    <Border x:Name="pnlRunning" Padding="12,0,0,0" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock x:Name="txtStatus" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar x:Name="pbProgress"
                                         Width="220" Height="8"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Ergebnis (fertig / Fehler / abgebrochen) -->
                    <Border x:Name="pnlResult" Padding="12,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtResultIcon" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtResultTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="btnOpenResult" Click="btnOpenResult_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Background="Transparent" BorderThickness="0" Margin="12,0,0,0" Padding="0" Visibility="Collapsed">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="20"
                                               Foreground="{StaticResource BrandYellowBrush}" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Border>
    </Grid>
</Page>
