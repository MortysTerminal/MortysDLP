<Page x:Class="MortysDLP.Views.ConvertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="clr-namespace:MortysDLP.Views"
      Title="Konvertieren"
      Loaded="ConvertPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- Sperr-Karte: sichtbar, wenn ffmpeg/ffprobe fehlt. -->
            <v:ToolMissingNotice x:Name="toolNotice"/>
            <StackPanel x:Name="pnlWork">

            <!-- Block 1: Dateien auswählen -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSection1Header" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid MinHeight="180" MaxHeight="350">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgFiles" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Grid.Row="0" 
                                  SelectionMode="Extended"
                                  Margin="0,0,0,8"
                                  AllowDrop="True"
                                  Drop="dgFiles_Drop"
                                  DragOver="dgFiles_DragOver">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="colFilename" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn x:Name="colStatus" Binding="{Binding Status}" Width="140"/>
                                <DataGridTemplateColumn x:Name="colProgress" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="18"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
                            <Button x:Name="btnAddFiles" Click="btnAddFiles_Click" MinWidth="100" Padding="12,4" Margin="0,0,8,0"/>
                            <Button x:Name="btnRemoveFiles" Click="btnRemoveFiles_Click" MinWidth="100" Padding="12,4" Margin="0,0,8,0"/>
                            <Button x:Name="btnClearFiles" Click="btnClearFiles_Click" MinWidth="100" Padding="12,4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Block 2: Zielformat und Pfad -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSection2Header" Style="{StaticResource SectionHeaderStyle}"/>
                    
                    <!-- Erste Zeile: Format und Zielordner -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="lblTargetFormat" VerticalAlignment="Center" Grid.Column="0" Padding="0" Style="{StaticResource FormLabelShortStyle}"/>
                        <ComboBox x:Name="cbTargetFormat" Width="120" SelectionChanged="cbTargetFormat_SelectionChanged" Margin="8,0,24,0" Grid.Column="1"/>
                        <Label x:Name="lblTargetFolder" VerticalAlignment="Center" Padding="0" Grid.Column="2" Style="{StaticResource FormLabelShortStyle}"/>
                        <TextBox x:Name="tbTargetFolder" VerticalContentAlignment="Center" Margin="8,0,0,0" Grid.Column="3"/>
                        <Button x:Name="btnBrowseTargetFolder" Click="btnBrowseTargetFolder_Click" MinWidth="100" Padding="12,4" Margin="8,0,0,0" Grid.Column="4"/>
                        <Button x:Name="btnOpenTargetFolder" Click="btnOpenTargetFolder_Click" MinWidth="100" Padding="12,4" Margin="8,0,0,0" Grid.Column="5"/>
                    </Grid>
                    
                    <!-- Zweite Zeile: Pfad übernehmen Buttons -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock x:Name="txtUsePath" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnUseSavedDownloadpath" Click="btnUseSavedDownloadpath_Click" Width="140" Margin="0,0,8,0"/>
                                <Button x:Name="btnUseSavedAudioOnlyPath" Click="btnUseSavedAudioOnlyPath_Click" Width="140"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Block 3: Qualitätsoptionen -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtSection3Header" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lblVideoQuality" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelShortStyle}"/>
                        <ComboBox x:Name="cbVideoQuality" Width="180" Margin="8,0,24,0">
                            <ComboBoxItem x:Name="cbiVideoQualityOriginal" IsSelected="True"/>
                            <ComboBoxItem Content="1080p"/>
                            <ComboBoxItem Content="720p"/>
                            <ComboBoxItem Content="480p"/>
                            <ComboBoxItem Content="360p"/>
                        </ComboBox>
                        <Label x:Name="lblAudioQuality" VerticalAlignment="Center" Padding="0" Style="{StaticResource FormLabelShortStyle}"/>
                        <ComboBox x:Name="cbAudioQuality" Width="180" Margin="8,0,0,0">
                            <ComboBoxItem x:Name="cbiAudioQualityOriginal" IsSelected="True"/>
                            <ComboBoxItem Content="320k"/>
                            <ComboBoxItem Content="192k"/>
                            <ComboBoxItem Content="128k"/>
                            <ComboBoxItem Content="64k"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Block 5: Debug-Ausgabe (nur sichtbar wenn Debug-Modus aktiv) -->
            <DockPanel x:Name="borderDebug" Margin="0,4,0,0" Visibility="Collapsed">
                <Expander x:Name="expDebug" IsExpanded="False">
                    <TextBox x:Name="tbDebugOutput"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             MaxHeight="200"/>
                </Expander>
            </DockPanel>

            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Block 4: Steuerung - fixierte Fußzeile, scrollt nicht mit -->
        <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnConvertStart" Click="btnConvertStart_Click" MinWidth="100" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="btnConvertCancel" Click="btnConvertCancel_Click" MinWidth="100" Padding="12,4"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>